#!/bin/sh
# pre-commit: быстрый гейт — сюита тестов перед каждым коммитом.
# Тесты-контракт: нельзя закоммитить код с падающими тестами.
# См. AGENTS.md / REVIEW_GUIDE.md. НЕ голый pytest (коллекция _scratch зависает).

echo "[pre-commit] python -m pytest tests/ -q ..."
PYTHONIOENCODING=utf-8 python -m pytest tests/ -q
status=$?

if [ "$status" -ne 0 ]; then
    echo ""
    echo "[pre-commit] ТЕСТЫ УПАЛИ (код $status) — коммит заблокирован."
    echo "[pre-commit] Почини тесты и повтори коммит."
    exit "$status"
fi

echo "[pre-commit] OK: тесты зелёные."
exit 0